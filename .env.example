# Postgres. Use a direct or session connection.
# Supabase transaction pooler (port 6543) cannot hold FOR UPDATE row locks.
# Neon: use the direct connection string for checkout, not the pooled one.
DATABASE_URL=postgres://ss:ss@localhost:5432/ss

# openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Local only. Production must be false, and deliverOtp() must send SMS/email.
OTP_DEBUG=true

# demo: simulate Razorpay capture. live: require the keys below.
# Leave unset to go live automatically when both keys exist.
PAYMENTS_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Bearer token for POST /api/cron/release-reservations
CRON_SECRET=replace-with-a-long-random-string

# Leave GSTIN empty to mark invoices as samples.
SELLER_LEGAL_NAME=SS Apparel Private Limited
SELLER_GSTIN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
